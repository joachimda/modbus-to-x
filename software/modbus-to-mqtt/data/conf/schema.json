{
  "title": "ModbusToXConfig",
  "type": "object",
  "required": [
    "version",
    "bus",
    "devices"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "bus": {
      "type": "object",
      "required": [
        "baud",
        "serialFormat"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "baud": {
          "type": "integer",
          "minimum": 1
        },
        "serialFormat": {
          "type": "string",
          "enum": [
            "7N1",
            "7N2",
            "7O1",
            "7O2",
            "7E1",
            "7E2",
            "8N1",
            "8N2",
            "8E1",
            "8E2",
            "8O1",
            "8O2"
          ]
        }
      },
      "additionalProperties": false
    },
    "devices": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "name",
          "slaveId",
          "dataPoints"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slaveId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 247
          },
          "mqttEnabled": {
            "type": "boolean",
            "default": false
          },
          "homeassistantDiscoveryEnabled": {
            "type": "boolean",
            "default": false
          },
          "dataPoints": {
            "type": "array",
            "minItems": 0,
            "maxItems": 200,
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "function",
                "address",
                "numOfRegisters",
                "dataType",
                "scale",
                "unit"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "function": {
                  "type": "integer",
                  "enum": [
                    1,
                    2,
                    3,
                    4,
                    5,
                    6,
                    16,
                    67,
                    68
                  ],
                  "default": 3,
                  "description": "Modbus function code. 67 (0x43) and 68 (0x44) are the Wavin AHC 9000 read and write functions, which address registers by category, index and page."
                },
                "address": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535,
                  "description": "Register or coil address. For Wavin functions (67/68): the register index, 0-255."
                },
                "category": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255,
                  "default": 0,
                  "description": "Wavin functions (67/68) only: register category (e.g. 1 elements, 2 packed data, 3 channels)."
                },
                "page": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255,
                  "default": 0,
                  "description": "Wavin functions (67/68) only: page within the category (e.g. the element or channel number)."
                },
                "numOfRegisters": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 125,
                  "default": 1,
                  "description": "Registers to read or write. Numeric types have a fixed width (int16/uint16: 1, int32/uint32/float32: 2, int64/uint64: 4): FC3/FC4 counts below the width are raised to it, FC16 always writes exactly the width, FC6 writes one register. TEXT uses the count as its length."
                },
                "scale": {
                  "type": "number",
                  "default": 1.0,
                  "description": "Engineering units per raw value, applied after the registers are decoded by dataType. FC6/FC16 values must be finite and non-zero; negative scales are supported. Published values carry as many decimals as the scale has."
                },
                "dataType": {
                  "type": "string",
                  "enum": [
                    "TEXT",
                    "int16",
                    "int32",
                    "int64",
                    "uint16",
                    "uint32",
                    "uint64",
                    "float32"
                  ],
                  "description": "Register encoding. int16/uint16 use one register (FC6 or FC16); int32/uint32/float32 use two and int64/uint64 four registers, written with FC16. FC6 cannot write multi-register types."
                },
                "unit": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 5,
                  "default": ""
                },
                "topic": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 128,
                  "default": ""
                },
                "registerSlice": {
                  "type": "string",
                  "enum": [
                    "full",
                    "low_byte",
                    "high_byte"
                  ],
                  "default": "full",
                  "description": "Part of a single register to use; 16-bit types only. int16 decodes a byte slice as a signed 8-bit value."
                },
                "wordOrder": {
                  "type": "string",
                  "enum": [
                    "big",
                    "little"
                  ],
                  "default": "big",
                  "description": "Register order of 32-bit and 64-bit values: big = the first (lowest-address) register holds the most significant word, little = the first register holds the least significant word. Ignored for 16-bit types and TEXT."
                },
                "poll_interval": {
                  "type": "integer",
                  "minimum": 0
                },
                "poll_interval_ms": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
